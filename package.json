{
  "name": "sokcho-taste-mac",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "electron:build:mac": "next build && electron-builder --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "firebase": "^12.12.0",
    "next": "16.2.3",
    "opentype.js": "^1.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0"
  },
  "build": {
    "appId": "com.sokcho.taste",
    "productName": "SokchoTasteBI",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "resources/icon.png",
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SokchoTasteBI"
    }
  },
  "description": "CULINARY CITY SOKCHO - 감각 시각화 시스템",
  "author": "안녕하는사이"
}
